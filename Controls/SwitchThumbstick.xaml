<UserControl x:Class="StardewSurfacePad.Controls.SwitchThumbstick"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="168"
             Height="168"
             IsManipulationEnabled="False">
    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Switch Pro dark charcoal translucent outer socket (#802D2D2D) + light gray stroke -->
        <Ellipse x:Name="OuterSocket"
                 Fill="#802D2D2D"
                 Stroke="#A8C8C8C8"
                 StrokeThickness="1.8" />

        <!-- Subtle travel guide ring -->
        <Ellipse Margin="22"
                 Fill="Transparent"
                 Stroke="#36E0E0E0"
                 StrokeThickness="1"
                 IsHitTestVisible="False" />

        <!-- Center directional ticks -->
        <Grid IsHitTestVisible="False" Opacity="0.25">
            <Rectangle Width="1.2" Height="16" VerticalAlignment="Top" Margin="0,8,0,0" Fill="#FFDCDCDC" />
            <Rectangle Width="1.2" Height="16" VerticalAlignment="Bottom" Margin="0,0,0,8" Fill="#FFDCDCDC" />
            <Rectangle Width="16" Height="1.2" HorizontalAlignment="Left" Margin="8,0,0,0" Fill="#FFDCDCDC" />
            <Rectangle Width="16" Height="1.2" HorizontalAlignment="Right" Margin="0,0,8,0" Fill="#FFDCDCDC" />
        </Grid>

        <!-- Movable thumbstick cap -->
        <Grid x:Name="ThumbCap"
              Width="74"
              Height="74"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsHitTestVisible="False">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ThumbTransform" X="0" Y="0" />
            </Grid.RenderTransform>

            <Ellipse x:Name="CapBody"
                     Fill="#CC222222"
                     Stroke="#C0D2D2D2"
                     StrokeThickness="1.8" />
            <Ellipse Margin="8"
                     Fill="#991B1B1B"
                     Stroke="#55E0E0E0"
                     StrokeThickness="1.2" />
            <TextBlock x:Name="StickLabel"
                       Text="L"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#88EAEAEA"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
