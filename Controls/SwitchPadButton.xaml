<UserControl x:Class="StardewSurfacePad.Controls.SwitchPadButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsManipulationEnabled="False">
    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <!-- Optional outer accent ring (e.g., Nintendo Red on 'A' button) -->
        <Border x:Name="OuterRing"
                Visibility="Collapsed"
                BorderThickness="2.2"
                BorderBrush="#AAE60012"
                Background="Transparent" />

        <!-- Main translucent matte Switch Pro button body -->
        <Border x:Name="BodyBorder"
                Margin="3"
                Background="#9E242424"
                BorderBrush="#9ED0D0D0"
                BorderThickness="1.5">
            <Grid>
                <!-- Subtle frosted highlight rim -->
                <Border x:Name="HighlightOverlay"
                        Background="#18FFFFFF"
                        Opacity="0"
                        CornerRadius="{Binding CornerRadius, ElementName=BodyBorder}" />

                <!-- Text label for ABXY / L / R / ZL / ZR / - / + -->
                <TextBlock x:Name="LabelText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#FFF5F5F5"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           IsHitTestVisible="False" />

                <!-- Switch Pro Capture icon (rounded square with inner circle) -->
                <Grid x:Name="CaptureIcon"
                      Visibility="Collapsed"
                      Width="18"
                      Height="18"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Border CornerRadius="3"
                            BorderBrush="#FFEAEAEA"
                            BorderThickness="1.6"
                            Background="Transparent" />
                    <Ellipse Width="8"
                             Height="8"
                             Stroke="#FFEAEAEA"
                             StrokeThickness="1.6"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
