<Window x:Class="StardewSurfacePad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StardewSurfacePad.Controls"
        Title="StardewSurfacePad"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Maximized"
        IsManipulationEnabled="False">
    <Grid x:Name="RootLayout">
        <!-- Main transparent touch-through canvas holding all Switch Pro clusters -->
        <Canvas x:Name="PadCanvas" Background="{x:Null}">

            <!-- Top-Left Curved Wide Shoulder Buttons: ZL & L -->
            <controls:PadClusterContainer x:Name="LeftShouldersCluster"
                                          ClusterTitle="左肩键 ZL / L">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <controls:SwitchPadButton x:Name="BtnZL"
                                              Label="ZL"
                                              LabelFontSize="17"
                                              Width="128"
                                              Height="50"
                                              Margin="0,0,8,0"
                                              ButtonCornerRadius="26,14,18,12" />
                    <controls:SwitchPadButton x:Name="BtnL"
                                              Label="L"
                                              LabelFontSize="17"
                                              Width="112"
                                              Height="44"
                                              Margin="0,4,0,0"
                                              ButtonCornerRadius="14,24,16,14" />
                </StackPanel>
            </controls:PadClusterContainer>

            <!-- Top-Right Curved Wide Shoulder Buttons: R & ZR -->
            <controls:PadClusterContainer x:Name="RightShouldersCluster"
                                          ClusterTitle="右肩键 R / ZR">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <controls:SwitchPadButton x:Name="BtnR"
                                              Label="R"
                                              LabelFontSize="17"
                                              Width="112"
                                              Height="44"
                                              Margin="0,4,8,0"
                                              ButtonCornerRadius="24,14,14,16" />
                    <controls:SwitchPadButton x:Name="BtnZR"
                                              Label="ZR"
                                              LabelFontSize="17"
                                              Width="128"
                                              Height="50"
                                              ButtonCornerRadius="14,26,12,18" />
                </StackPanel>
            </controls:PadClusterContainer>

            <!-- Top Center System Buttons: - (Minus), Capture (Edit Toggle), + (Plus) -->
            <controls:PadClusterContainer x:Name="SystemBarCluster"
                                          ClusterTitle="系统功能键 (- / 截图 / +)">
                <Border Background="#44161616"
                        BorderBrush="#44C8C8C8"
                        BorderThickness="1"
                        CornerRadius="26"
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:SwitchPadButton x:Name="BtnMinus"
                                                  Label="−"
                                                  LabelFontSize="22"
                                                  Width="46"
                                                  Height="46"
                                                  Margin="0,0,14,0" />
                        <controls:SwitchPadButton x:Name="BtnCapture"
                                                  IsCaptureButton="True"
                                                  Width="42"
                                                  Height="42"
                                                  ButtonCornerRadius="9"
                                                  Margin="0,0,14,0"
                                                  ToolTip="切换编辑 / 锁定模式" />
                        <controls:SwitchPadButton x:Name="BtnPlus"
                                                  Label="+"
                                                  LabelFontSize="22"
                                                  Width="46"
                                                  Height="46" />
                    </StackPanel>
                </Border>
            </controls:PadClusterContainer>

            <!-- Left Analog Stick -->
            <controls:PadClusterContainer x:Name="LeftStickCluster"
                                          ClusterTitle="左摇杆 (移动)">
                <controls:SwitchThumbstick x:Name="LeftStick"
                                           Caption="L"
                                           Width="172"
                                           Height="172" />
            </controls:PadClusterContainer>

            <!-- Left D-Pad -->
            <controls:PadClusterContainer x:Name="DPadCluster"
                                          ClusterTitle="十字键">
                <controls:SwitchDPad x:Name="DPad"
                                     Width="148"
                                     Height="148" />
            </controls:PadClusterContainer>

            <!-- Right ABXY Diamond (Nintendo Layout: Top=X, Left=Y, Right=A[Largest+Red Ring], Bottom=B) -->
            <controls:PadClusterContainer x:Name="FaceButtonsCluster"
                                          ClusterTitle="ABXY 按键">
                <Grid Width="212" Height="212">
                    <!-- Top: X -->
                    <controls:SwitchPadButton x:Name="BtnX"
                                              Label="X"
                                              LabelFontSize="20"
                                              Width="62"
                                              Height="62"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Top"
                                              Margin="0,4,0,0" />
                    <!-- Left: Y -->
                    <controls:SwitchPadButton x:Name="BtnY"
                                              Label="Y"
                                              LabelFontSize="20"
                                              Width="62"
                                              Height="62"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="4,0,0,0" />
                    <!-- Right: A (Largest primary confirm/tool button with Nintendo Red outer ring) -->
                    <controls:SwitchPadButton x:Name="BtnA"
                                              Label="A"
                                              LabelFontSize="25"
                                              Width="76"
                                              Height="76"
                                              AccentRingBrush="{StaticResource NintendoRedBrush}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,0,0" />
                    <!-- Bottom: B -->
                    <controls:SwitchPadButton x:Name="BtnB"
                                              Label="B"
                                              LabelFontSize="20"
                                              Width="62"
                                              Height="62"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Bottom"
                                              Margin="0,0,0,4" />
                </Grid>
            </controls:PadClusterContainer>

            <!-- Right Analog Stick (Cursor / Camera Pan) -->
            <controls:PadClusterContainer x:Name="RightStickCluster"
                                          ClusterTitle="右摇杆 (指针)">
                <controls:SwitchThumbstick x:Name="RightStick"
                                           Caption="R"
                                           Width="136"
                                           Height="136" />
            </controls:PadClusterContainer>
        </Canvas>

        <!-- Edit Mode Floating Control Panel (visible only when Capture toggles Edit Mode) -->
        <Border x:Name="EditToolbar"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,78,0,0"
                Padding="16,12"
                CornerRadius="14"
                Background="#E81D1D1F"
                BorderBrush="#88CCCCCC"
                BorderThickness="1.2">
            <StackPanel Width="460">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Switch Pro 手柄布局编辑模式"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="14"
                               VerticalAlignment="Center" />
                    <Button x:Name="BtnLockLayout"
                            Content="完成锁定"
                            DockPanel.Dock="Right"
                            Padding="14,5"
                            Background="#FFE60012"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnLockLayout_Click" />
                </DockPanel>

                <TextBlock Text="直接拖动屏幕上的按键组即可调整 Surface 握持位置。"
                           Foreground="#FFB8B8B8"
                           FontSize="12"
                           Margin="0,0,0,6" />

                <TextBlock Text="免驱动按键：摇杆=WASD | A=对话/收获 | X/ZR=挥工具 | B=背包 | Y=地图 | L/R=切栏 | ZL=切排 | -=日志 | +=菜单"
                           Foreground="#FF9EC6FF"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <!-- Status row -->
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="StatusText"
                               Text="免驱动直连模式（即开即用）"
                               Foreground="#FF8CE99A"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <Button x:Name="BtnToggleBackend"
                            Content="检测 ViGEm 驱动"
                            DockPanel.Dock="Right"
                            Padding="10,3"
                            Background="#FF38383C"
                            Foreground="White"
                            BorderBrush="#66AAAAAA"
                            BorderThickness="1"
                            Click="BtnToggleBackend_Click" />
                </DockPanel>

                <!-- Block touch-mouse toggle -->
                <CheckBox x:Name="ChkBlockTouchMouse"
                          Content="禁止触屏触发鼠标（仅右摇杆控制鼠标指针，防误触）"
                          Foreground="#FFEAEAEA"
                          FontSize="12"
                          Margin="0,0,0,10"
                          Checked="ChkBlockTouchMouse_Changed"
                          Unchecked="ChkBlockTouchMouse_Changed" />

                <!-- Opacity Slider -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="透明度" Foreground="#FFD8D8D8" FontSize="12" VerticalAlignment="Center" />
                    <Slider x:Name="OpacitySlider"
                            Grid.Column="1"
                            Minimum="0.30"
                            Maximum="1.0"
                            SmallChange="0.05"
                            LargeChange="0.1"
                            ValueChanged="OpacitySlider_ValueChanged" />
                    <TextBlock x:Name="OpacityValueText"
                               Grid.Column="2"
                               Foreground="#FFD8D8D8"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Scale Slider -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="按键大小" Foreground="#FFD8D8D8" FontSize="12" VerticalAlignment="Center" />
                    <Slider x:Name="ScaleSlider"
                            Grid.Column="1"
                            Minimum="0.75"
                            Maximum="1.35"
                            SmallChange="0.05"
                            LargeChange="0.1"
                            ValueChanged="ScaleSlider_ValueChanged" />
                    <TextBlock x:Name="ScaleValueText"
                               Grid.Column="2"
                               Foreground="#FFD8D8D8"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="恢复默认布局"
                            Padding="12,5"
                            Margin="0,0,10,0"
                            Background="#FF35353A"
                            Foreground="White"
                            BorderBrush="#66AAAAAA"
                            BorderThickness="1"
                            Click="BtnResetLayout_Click" />
                    <Button Content="退出手柄悬浮窗"
                            Padding="12,5"
                            Background="#FF502226"
                            Foreground="#FFFFD6D6"
                            BorderBrush="#88E60012"
                            BorderThickness="1"
                            Click="BtnExitApp_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
